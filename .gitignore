## .gitignore para ASP.NET Core / Visual Studio / VS Code

# Resultados de compilación
[Bb]in/
[Oo]bj/
[Oo]ut/
[Pp]ublish/
artifacts/
*.dll
*.exe
*.pdb
*.cache

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser
*.vsidx
[Dd]ebug/
[Rr]elease/
x64/
x86/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider
.idea/
*.sln.iml

# Resultados de pruebas y cobertura
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
.nuget/

# Secretos y configuración local (no subir)
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
.env
.env.*

# Node (si agregas herramientas de frontend)
node_modules/

# Publicación y despliegue
*.pubxml
*.pubxml.user
PublishScripts/
.azure/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Registros
*.log
logs/
