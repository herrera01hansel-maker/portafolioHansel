<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de Hansel Steven Herrera Serrano: inteligencia de negocios, datos y desarrollo web con ASP.NET Core." />
    <title>@ViewData["Title"] - Hansel Herrera</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Instrument+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
        <div class="contenedor cabecera-fila">
            <a class="marca" href="#inicio">Hansel Herrera</a>
            <nav aria-label="Principal">
                <ul class="menu">
                    <li><a href="#sobre-mi">Sobre mí</a></li>
                    <li><a href="#habilidades">Habilidades</a></li>
                    <li><a href="#proyectos">Proyectos</a></li>
                    <li><a href="#despliegue">Despliegue</a></li>
                    <li><a href="#contacto">Contacto</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="contenido">
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="contenedor">
            <p>&copy; @DateTime.Now.Year Hansel Steven Herrera Serrano. Hecho con ASP.NET Core y publicado con Azure.</p>
        </div>
    </footer>
</body>
</html>
